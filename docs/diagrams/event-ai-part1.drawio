        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="pipe">
          <mxGeometry x="45" y="90" width="10" height="840" as="geometry"/>
        </mxCell>
        <mxCell id="m0" value="question + chat history" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0882;entryX=0;entryY=0.0;" edge="1" parent="1" source="user" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="question, history, table schema" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0595;entryX=0;entryY=0.0;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="act4" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="plan: tools + inputs (SQL, search words)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.119;" edge="1" parent="1" source="act0" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note3" value="Chooses the tools and writes their inputs. One decision, made before any data comes back." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="650" y="260" width="210" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="run the SQL behind 6 guardrails" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.25;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="read the tables (venues, packages, policies)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4167;entryX=1;entryY=0.6667;strokeColor=#82b366;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="act1" target="act1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="960" y="390"/><mxPoint x="960" y="420"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="rows + source IDs, e.g. venues.csv#V012" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.3929;" edge="1" parent="1" source="act1" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note7" value="On an SQL error only: one repair LLM call (call 3), then all the guardrails again." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="920" y="490" width="210" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="search words + the record IDs from the SQL" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5238;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m9" value="rank the text fields (vectors + BM25, RRF)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4167;entryX=1;entryY=0.6667;strokeColor=#82b366;strokeWidth=2;fontStyle=1;" edge="1" parent="1" source="act2" target="act2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1230" y="620"/><mxPoint x="1230" y="650"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="top hits + full record text" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6667;" edge="1" parent="1" source="act2" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="question + tool results + allowed source IDs" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.7262;entryX=0;entryY=0.0;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="answer JSON: facts, each with a source ID" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.7857;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note13" value="First time the model sees data: it writes the reply from the tool results only." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1460" y="820" width="210" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m14" value="citation check: drop facts with unknown IDs" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.9167;entryX=1;entryY=0.9524;" edge="1" parent="1" source="act4" target="act4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="420" y="900"/><mxPoint x="420" y="930"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m15" value="answer, facts, Sources, Debug" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.9118;" edge="1" parent="1" source="act4" target="user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      <mxCell id="t4" value="Event AI · Who calls the LLM, and who gets the data" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="key4" value="&lt;b&gt;The router chooses; code executes.&lt;/b&gt; The router LLM picks the tools and writes their inputs, the SQL and the search words (call 1), so its choice decides which data comes back. Code runs the chosen tools in a fixed order, behind the guardrails; only these code steps read the data. The model sees the results once, when it writes the answer (call 2). &lt;b&gt;One decision, not a loop&lt;/b&gt;: a third call only repairs broken SQL. The Part 2 agent is the loop: it sees each result and decides again." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=12;spacingRight=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="900" height="100" as="geometry"/></mxCell><mxCell id="lg4" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="980" y="1090" width="210" height="102" as="geometry"/></mxCell><mxCell id="lg4-s0" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg4"><mxGeometry x="10" y="30" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg4-t0" value="LLM call (2 per question)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg4"><mxGeometry x="50" y="28" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg4-s1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg4"><mxGeometry x="10" y="54" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg4-t1" value="Code" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg4"><mxGeometry x="50" y="52" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg4-s2" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lg4"><mxGeometry x="10" y="78" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg4-t2" value="Code that reads the data" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg4"><mxGeometry x="50" y="76" width="150" height="20" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram></mxfile>