t;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="76" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s3" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lg"><mxGeometry x="10" y="102" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t3" value="Output" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="100" width="150" height="20" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;One email of thirteen.&lt;/b&gt; Each step works on all the emails at once. Only the Loop goes one flag at a time." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="220" width="260" height="90" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;The pattern:&lt;/b&gt; the LLM reads and proposes (steps 3 and 5). Code checks, decides and records (steps 4 and 6). Each change has an audit entry with its source." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="340" width="260" height="110" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Zoom in:&lt;/b&gt; the agent loop for this flag is the page &quot;3 · The agent loop for one flag&quot; in event-ai-part2.drawio." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="480" width="260" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="w2" name="2 · Four paths for an email"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Event AI · Part 2: the four paths that an email can take" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="inbox" value="&lt;b&gt;Gmail inbox&lt;/b&gt; of the demo account&lt;br&gt;13 RSVPs, plus 4 other emails from 28 Oct (D19)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="380" height="60" as="geometry"/></mxCell><mxCell id="load" value="&lt;b&gt;Load RSVP Emails&lt;/b&gt; (code)&lt;br&gt;search: &quot;Northern Partners Summit&quot; -from:me" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="380" height="60" as="geometry"/></mxCell><mxCell id="out0" value="&lt;b&gt;Never read&lt;/b&gt; (the search does not find them)&lt;br&gt;e17 a venue newsletter&lt;br&gt;e18 an advert for &quot;Northern Leaders Summit 2027&quot;&lt;br&gt;&lt;i&gt;no LLM call&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="320" height="90" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;Extract RSVPs&lt;/b&gt; (LLM)&lt;br&gt;one call per email: the fields and is_rsvp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="420" y="270" width="380" height="60" as="geometry"/></mxCell><mxCell id="chk" value="&lt;b&gt;Check Records&lt;/b&gt; (code)&lt;br&gt;filter · ground · normalize · dedupe · verify" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="370" width="380" height="60" as="geometry"/></mxCell><mxCell id="pa" value="&lt;b&gt;A · Not an RSVP → skipped&lt;/b&gt; (D19)&lt;br&gt;&lt;br&gt;e15 Ravi Desai: out-of-office reply&lt;br&gt;e16 Fenwick &amp;amp; Rowe: catering quote&lt;br&gt;&lt;br&gt;&lt;i&gt;An audit entry and a line in the run report. Not on the list, so Ravi stays under &quot;no reply&quot;.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="280" height="215" as="geometry"/></mxCell><mxCell id="epa" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chk" target="pa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pb" value="&lt;b&gt;B · Clean → on the list&lt;/b&gt;&lt;br&gt;&lt;br&gt;A01 Amelia Hart&lt;br&gt;A02 Priya Shah: case fixed by code&lt;br&gt;A08 Oliver Grant: no phone (info flag only)&lt;br&gt;A11 Ewan Fraser: declines → attending no&lt;br&gt;&lt;br&gt;&lt;i&gt;No flag that needs judgement, so no agent call.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="490" width="280" height="215" as="geometry"/></mxCell><mxCell id="epb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chk" target="pb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc" value="&lt;b&gt;C · Duplicates → merged by code&lt;/b&gt;&lt;br&gt;&lt;br&gt;A03 Marcus Bell: e03 + e04 from one address; the later email adds &quot;vegetarian&quot;&lt;br&gt;A04 Jonathan Reed: e05 work + e06 personal address; the CRM settles the name and the email&lt;br&gt;&lt;br&gt;&lt;i&gt;A conflict that the CRM settles is a rule, not a judgement.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="490" width="280" height="215" as="geometry"/></mxCell><mxCell id="epc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chk" target="pc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pd" value="&lt;b&gt;D · Flag → Agent → code check&lt;/b&gt;&lt;br&gt;&lt;br&gt;Accepted, the value is in the CRM:&lt;br&gt;A05 Bob → Robert Harper (C006)&lt;br&gt;A06 Sam Okoro: phone (C007)&lt;br&gt;A07 Brightwyn Analytcs → Brightwyn Analytics Ltd (C008)&lt;br&gt;Human review:&lt;br&gt;A09 Leah Morgan: a substitute, not invited&lt;br&gt;A10 Chloe Adams: the reply is not clear" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="940" y="490" width="280" height="215" as="geometry"/></mxCell><mxCell id="epd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chk" target="pd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wo" value="&lt;b&gt;Apply Decisions → Write Outputs&lt;/b&gt; (code)&lt;br&gt;11 attendees · 9 attending of 100 seats · 5 flagged: 3 fixed, 2 to human review&lt;br&gt;Invited, no reply: Tom Price, Ravi Desai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="760" width="560" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inbox" target="load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="load" target="ext"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ext" target="chk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="left out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#7f7f7f;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="load" target="out0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wpb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pb" target="wo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wpc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pc" target="wo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wpd" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pd" target="wo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wpa" value="run report only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#7f7f7f;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="pa" target="wo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="800"/></Array></mxGeometry></mxCell><mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1270" y="70" width="210" height="150" as="geometry"/></mxCell><mxCell id="lg-s0" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg"><mxGeometry x="10" y="30" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t0" value="LLM step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="28" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="10" y="54" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t1" value="Code step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="52" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s2" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lg"><mxGeometry x="10" y="78" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t2" value="On the list" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="76" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s3" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="lg"><mxGeometry x="10" y="102" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t3" value="Skipped (audited)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="100" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s4" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lg"><mxGeometry x="10" y="126" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t4" value="Never read" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="124" width="150" height="20" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Who decides what is on the list?&lt;/b&gt; Code. The LLM extracts the fields and says whether an email is an RSVP; the Agent proposes a fix for each flag. Code accepts a fix only when the value is in the evidence." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="870" y="155" width="360" height="100" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Numbers from the committed run&lt;/b&gt; (28 Oct, 08:09, 13 emails). Path A starts with the run on 29 Oct, after the noise emails went into the inbox." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="870" y="290" width="360" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="w3" name="3 · Where Part 1 works in Part 2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Event AI · Where Part 1 works inside a Part 2 run" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="a2" value="Part 2 run · Langflow on the laptop" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fillColor=#fbf8fc;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="380" height="600" as="geometry"/></mxCell><mxCell id="a1" value="Part 1 · the same repository and eventai code" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fillColor=#f7fafd;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="380" height="600" as="geometry"/></mxCell><mxCell id="le" value="&lt;b&gt;Load Event&lt;/b&gt; (code)&lt;br&gt;the event description says &quot;Venue: V113&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="320" height="70" as="geometry"/></mxCell><mxCell id="lc" value="&lt;b&gt;Check Records&lt;/b&gt; (code)&lt;br&gt;capacity check: 9 attending, 100 seats → not over" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="320" height="70" as="geometry"/></mxCell><mxCell id="lb" value="&lt;b&gt;Planner Brief&lt;/b&gt; (code)&lt;br&gt;4 questions, built from this run&#x27;s data&lt;br&gt;Part 1 answers them with sources&lt;br&gt;code turns each cited rule into a date" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="320" height="100" as="geometry"/></mxCell><mxCell id="lw" value="&lt;b&gt;Write Outputs&lt;/b&gt; (code)&lt;br&gt;planner_brief.md · run_report.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="320" height="70" as="geometry"/></mxCell><mxCell id="rd" value="&lt;b&gt;data/&lt;/b&gt; · the Part 1 knowledge base&lt;br&gt;venues.csv · policies.csv · packages.json" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1030" y="120" width="320" height="70" as="geometry"/></mxCell><mxCell id="ra" value="&lt;b&gt;ask(question)&lt;/b&gt; · eventai.rag.pipeline&lt;br&gt;router (LLM) → query_sql / search_text (code)&lt;br&gt;→ answer (LLM) → citation check (code)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1030" y="380" width="320" height="100" as="geometry"/></mxCell><mxCell id="rr" value="&lt;b&gt;Part 2 results page&lt;/b&gt;&lt;br&gt;in the Part 1 web app, read-only (D6)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1030" y="560" width="320" height="70" as="geometry"/></mxCell><mxCell id="lelc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="le" target="lc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lclb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lc" target="lb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lblw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lb" target="lw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cap" value="① the same data file: seated_capacity of V113 = 100 (no LLM)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#d79b00;" edge="1" parent="1" source="rd" target="lc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="155"/><mxPoint x="700" y="285"/></Array></mxGeometry></mxCell><mxCell id="ask" value="② ask() four times, in the Part 1 venv (a subprocess)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=block;startFill=1;startSize=8;strokeColor=#d79b00;" edge="1" parent="1" source="lb" target="ra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reads" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ra" target="rd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pub" value="③ commit and push → the page shows the run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d79b00;" edge="1" parent="1" source="lw" target="rr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ex" value="&lt;b&gt;One brief question, end to end&lt;/b&gt; (the 28 Oct run)&lt;table style=&#x27;border-collapse:collapse;margin-top:6px&#x27; border=&#x27;1&#x27; cellpadding=&#x27;4&#x27;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Question&lt;/b&gt; (Part 2 code)&lt;/td&gt;&lt;td&gt;When are final guest numbers due for an event on 26 November 2026, and what happens if guest numbers rise after that?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Router&lt;/b&gt; (Part 1 LLM)&lt;/td&gt;&lt;td&gt;SELECT policy_id, area, applies_to, condition, rule, effective_from FROM policies WHERE area = &#x27;guest numbers&#x27;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;query_sql&lt;/b&gt; (code)&lt;/td&gt;&lt;td&gt;read-only DuckDB, after the six guardrails → all the guest-number rules&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Answer&lt;/b&gt; (Part 1 LLM)&lt;/td&gt;&lt;td&gt;&quot;Final guest numbers are due 10 working days before the 26 November 2026 event …&quot; · sources POL-GST-01, POL-GST-04&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Citation check&lt;/b&gt; (code)&lt;/td&gt;&lt;td&gt;each source ID was in the tool results&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Date&lt;/b&gt; (Part 2 code)&lt;/td&gt;&lt;td&gt;POL-GST-01 applies to all events: 10 working days before Thu 26 Nov → &lt;b&gt;Thu 12 Nov 2026&lt;/b&gt; (weekends skipped). A rule for one package only (POL-GST-02, Gala Dinner) sets no date.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;To do&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Send the final guest numbers (9 attending) by Thu 12 Nov 2026 (policies.csv#POL-GST-01)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;The other three questions&lt;/b&gt; ask about dietary needs (POL-DIE-01 → Thu 12 Nov), the venue and access (V113: step-free, in-house catering, 100 seats) and data retention (POL-DAT-02 → Sat 26 Dec)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1340" height="250" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Why code computes the dates:&lt;/b&gt; an LLM is not reliable with working-day arithmetic. Part 1 finds and cites the rule; Part 2 code does the sum." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="455" width="480" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>