trig" value="&lt;b&gt;Run command&lt;/b&gt; or &lt;b&gt;Gmail watcher&lt;/b&gt; · python -m eventai.agent.run → Langflow server API" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p2"><mxGeometry x="20" y="45" width="480" height="50" as="geometry"/></mxCell><mxCell id="goog" value="&lt;b&gt;Google Calendar + Gmail&lt;/b&gt; (demo account, read-only)&lt;br&gt;event · invitees · venue ID V113 · emails that name the event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="p2"><mxGeometry x="20" y="120" width="480" height="60" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b&gt;Extract RSVPs&lt;/b&gt; (LLM) → &lt;b&gt;Check Records&lt;/b&gt; (code)&lt;br&gt;→ &lt;b&gt;Loop: Agent&lt;/b&gt; with 3 read-only tools (LLM)&lt;br&gt;→ &lt;b&gt;Apply Decisions&lt;/b&gt; (code)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p2"><mxGeometry x="20" y="210" width="480" height="80" as="geometry"/></mxCell><mxCell id="brief" value="&lt;b&gt;Planner Brief&lt;/b&gt; (code)&lt;br&gt;asks Part 1 four questions about this event&lt;br&gt;code computes the dates from the cited rules" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2"><mxGeometry x="20" y="330" width="480" height="80" as="geometry"/></mxCell><mxCell id="wout" value="&lt;b&gt;Write Outputs&lt;/b&gt; → outputs/ (committed)&lt;br&gt;attendees.csv · audit_log.json · run_report.json · planner_brief.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p2"><mxGeometry x="20" y="460" width="480" height="70" as="geometry"/></mxCell><mxCell id="trig-goog" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="trig" target="goog"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="goog-flow" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="goog" target="flow"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-brief" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="flow" target="brief"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="brief-wout" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="brief" target="wout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b1" value="① venue capacity&lt;br&gt;Check Records reads venues.csv#V113" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="data" target="flow"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b2" value="② ask() in the Part 1 venv (subprocess)&lt;br&gt;4 questions → cited answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;fontStyle=1;startArrow=block;startFill=1;startSize=8;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="brief" target="ask"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b3" value="③ git push → results page (D6)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=2;strokeColor=#d79b00;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="wout" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sh" value="Shared · one repository" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=13;container=1;pointerEvents=0;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1360" height="130" as="geometry"/></mxCell><mxCell id="pkg" value="&lt;b&gt;eventai package&lt;/b&gt;&lt;br&gt;rag/ (Part 1) · agent/ (Part 2)&lt;br&gt;llm.py: provider order (D15) · config.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="sh"><mxGeometry x="20" y="40" width="420" height="70" as="geometry"/></mxCell><mxCell id="lf" value="&lt;b&gt;Langfuse Cloud&lt;/b&gt; · one project&lt;br&gt;Part 1: a trace for each question&lt;br&gt;Part 2: a trace for each run; the brief shares its session ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="sh"><mxGeometry x="470" y="40" width="420" height="70" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;Tests and scores&lt;/b&gt;&lt;br&gt;pytest (offline, no LLM call)&lt;br&gt;eval/run_part1.py · eval/run_part2.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="sh"><mxGeometry x="920" y="40" width="420" height="70" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Connected:&lt;/b&gt; one client (the event company), one event at Part 1 venue V113, one code base, one Langfuse project, and one web app that shows the results of both parts." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=12;align=left;spacingLeft=10;spacingRight=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="660" height="80" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Distinct:&lt;/b&gt; Part 1 runs in the cloud for anyone; Part 2 runs on the laptop with the Google demo account. Each has its own venv (Langflow pins older duckdb, pydantic and langfuse). Part 1 never calls Part 2. Part 2 reaches Part 1 only through ask(), the same function the website uses." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=12;align=left;spacingLeft=10;spacingRight=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="740" y="820" width="660" height="80" as="geometry"/></mxCell><mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1440" y="70" width="210" height="174" as="geometry"/></mxCell><mxCell id="lg-s0" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lg"><mxGeometry x="10" y="30" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t0" value="Data file" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="28" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lg"><mxGeometry x="10" y="54" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t1" value="Output files" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="52" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s2" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="10" y="78" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t2" value="Code step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="76" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s3" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg"><mxGeometry x="10" y="102" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t3" value="LLM step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="100" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s4" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="lg"><mxGeometry x="10" y="126" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t4" value="Person or service" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="124" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s5" value="" style="rounded=0;html=1;strokeColor=#d79b00;fillColor=#ffffff;strokeWidth=2;" vertex="1" parent="lg"><mxGeometry x="10" y="150" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t5" value="Link between the parts" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="148" width="150" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>