="60" as="geometry"/></mxCell><mxCell id="ag" value="&lt;b&gt;Agent&lt;/b&gt; (LLM)&lt;br&gt;reads the flag, calls ≤ 3 tools&lt;br&gt;Max Iterations 4&lt;br&gt;Structured Response: 6 fields" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="body"><mxGeometry x="220" y="40" width="200" height="80" as="geometry"/></mxCell><mxCell id="ad" value="&lt;b&gt;Agent Decision&lt;/b&gt; (code)&lt;br&gt;in: Structured Response&lt;br&gt;out: the decision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="body"><mxGeometry x="450" y="45" width="150" height="70" as="geometry"/></mxCell><mxCell id="crm" value="&lt;b&gt;CRM Lookup&lt;/b&gt;&lt;br&gt;Tool Mode · crm_lookup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="body"><mxGeometry x="60" y="190" width="150" height="60" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b&gt;Invitee Lookup&lt;/b&gt;&lt;br&gt;Tool Mode · invitee_lookup" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="body"><mxGeometry x="230" y="190" width="150" height="60" as="geometry"/></mxCell><mxCell id="chs" value="&lt;b&gt;Company Search&lt;/b&gt;&lt;br&gt;Tool Mode · company_search" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="body"><mxGeometry x="400" y="190" width="190" height="60" as="geometry"/></mxCell><mxCell id="item" value="Item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="loop" target="tc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tc-ag" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tc" target="ag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ag-ad" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ag" target="ad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="back" value="Decision → Item (looping)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="ad" target="loop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="640"/><mxPoint x="1290" y="880"/><mxPoint x="580" y="880"/><mxPoint x="580" y="652"/></Array></mxGeometry></mxCell><mxCell id="crm-ag" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="crm" target="ag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="inv-ag" value="Tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="inv" target="ag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="chs-ag" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="chs" target="ag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1" value="&lt;b&gt;Part 1 RAG pipeline&lt;/b&gt;&lt;br&gt;ask() in the Part 1 venv (subprocess)&lt;br&gt;guest numbers · dietary needs&lt;br&gt;venue and access · data retention" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1040" width="280" height="90" as="geometry"/></mxCell><mxCell id="pb-p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;startSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pb" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="out" value="&lt;b&gt;outputs/&lt;/b&gt;&lt;br&gt;attendees.csv · audit_log.json&lt;br&gt;run_report.json · planner_brief.md" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="1150" width="280" height="90" as="geometry"/></mxCell><mxCell id="wo-out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wo" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n1" value="&lt;b&gt;Langflow 1.13 on the laptop&lt;/b&gt;, in its own venv. Each Event AI component wraps a tested eventai module; the canvas only wires them. 16 components plus Agent Decision and Planner Brief." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1320" y="300" width="300" height="100" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;No input from before the Loop into its body.&lt;/b&gt; The Loop runs its body as a sub-graph with every predecessor, so a link to Load Event re-ran the start of the flow for each flag. The tools read the event from memory instead." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1320" y="560" width="300" height="120" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Why Agent Decision.&lt;/b&gt; The Loop collects the first output of the last box in its body. The Agent&#x27;s first output is its text Response. Agent Decision has one output, so the Loop collects the decision." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1320" y="710" width="300" height="110" as="geometry"/></mxCell><mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1320" y="900" width="210" height="150" as="geometry"/></mxCell><mxCell id="lg-s0" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg"><mxGeometry x="10" y="30" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t0" value="LLM step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="28" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="10" y="54" width="30" height="16" as="geometry"/></mx