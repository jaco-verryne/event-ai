l id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#7f7f7f;exitX=1;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="agent" target="llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="632"/><mxPoint x="1050" y="350"/></Array></mxGeometry></mxCell><mxCell id="e14" value="company_search tool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0.5;entryY=1;" edge="1" parent="1" source="agent" target="ch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="614"/></Array></mxGeometry></mxCell><mxCell id="e15" value="traces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#7f7f7f;exitX=1;exitY=0.107;entryX=0;entryY=0.5;" edge="1" parent="1" source="run" target="lf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="write" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="out" target="app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="scored by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="out" target="score"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;startSize=8;exitX=1;exitY=0.5;entryX=0;entryY=0.722;" edge="1" parent="1" source="write" target="p1rag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="why" value="&lt;b&gt;Code does the checks; the LLM extracts and judges.&lt;/b&gt;&lt;br&gt;The agent runs only for flagged records. Its tools are read-only, it makes at most 3 calls for each flag, and code accepts a fix only when the value is in the evidence." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1110" y="330" width="300" height="130" as="geometry"/></mxCell><mxCell id="why2" value="&lt;b&gt;Each Event AI component wraps a tested module&lt;/b&gt; (eventai.agent). The canvas only wires them. The same modules run in the unit tests and in the smoke test." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1110" y="500" width="300" height="100" as="geometry"/></mxCell><mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="210" height="150" as="geometry"/></mxCell><mxCell id="lg-s0" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lg"><mxGeometry x="10" y="30" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t0" value="Data file" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="28" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lg"><mxGeometry x="10" y="54" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t1" value="Output files" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="52" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s2" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="10" y="78" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t2" value="Code step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="76" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s3" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg"><mxGeometry x="10" y="102" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t3" value="LLM step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="100" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s4" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="lg"><mxGeometry x="10" y="126" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t4" value="External service" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="124" width="150" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 · The Langflow flow"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Event AI · Part 2 flow in Langflow: components and connections" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="chat" value="&lt;b&gt;Chat Input&lt;/b&gt;&lt;br&gt;partnersummit2026" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="260" height="50" as="geometry"/></mxCell><mxCell id="ev" value="&lt;b&gt;Load Event&lt;/b&gt; (code)&lt;br&gt;Source = google: Calendar, read-only&lt;br&gt;event · invitees · venue ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="260" height="70" as="geometry"/></mxCell><mxCell id="em" value="&lt;b&gt;Load RSVP Emails&lt;/b&gt; (code)&lt;br&gt;Gmail search, read-only&lt;br&gt;emails with Date and Message-ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="260" height="70" as="geometry"/></mxCell><mxCell id="ex" value="&lt;b&gt;Extract RSVPs&lt;/b&gt; (LLM)&lt;br&gt;one call per email → ExtractedRsvp&lt;br&gt;one retry, then the fallback model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="260" height="70" as="geometry"/></mxCell><mxCell id="ck" value="&lt;b&gt;Check Records&lt;/b&gt; (code)&lt;br&gt;ground · normalize · dedupe · verify&lt;br&gt;outputs: Checked records,&lt;br&gt;Review queue (one item per flag)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="260" height="80" as="geometry"/></mxCell><mxCell id="loop" value="&lt;b&gt;Loop&lt;/b&gt;&lt;br&gt;Item: one flag at a time&lt;br&gt;Done: all the decisions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="600" width="260" height="70" as="geometry"/></mxCell><mxCell id="ap" value="&lt;b&gt;Apply Decisions&lt;/b&gt; (code)&lt;br&gt;is the value in the evidence?&lt;br&gt;no → human review, with a reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="940" width="260" height="70" as="geometry"/></mxCell><mxCell id="pb" value="&lt;b&gt;Planner Brief&lt;/b&gt; (code)&lt;br&gt;asks Part 1 four questions&lt;br&gt;code computes the dates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="1050" width="260" height="70" as="geometry"/></mxCell><mxCell id="wo" value="&lt;b&gt;Write Outputs&lt;/b&gt; (code)&lt;br&gt;status and source for each field&lt;br&gt;audit log · run report" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="1160" width="260" height="70" as="geometry"/></mxCell><mxCell id="co" value="&lt;b&gt;Chat Output&lt;/b&gt;&lt;br&gt;summary and dated actions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="300" y="1270" width="260" height="50" as="geometry"/></mxCell><mxCell id="chat-ev" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="chat" target="ev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ev-em" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=bloc