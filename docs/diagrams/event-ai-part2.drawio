        <mxCell id="note7" value="Agent Decision passes the decision back. The Loop sends the next flag." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
