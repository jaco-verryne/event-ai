        <mxCell id="note9" value="Code check: +441134960712 is in CRM row C007 → accepted (corrected, crm.csv#C007)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
