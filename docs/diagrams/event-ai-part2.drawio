        </mxCell>
      <mxCell id="t3" value="Event AI · The agent loop for one flag (A06 from e10, invalid phone)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1000" height="40" as="geometry"/></mxCell><mxCell id="key3" value="&lt;b&gt;The model chooses; code executes and checks.&lt;/b&gt; For each flag, the Agent reads the record and the flag, asks for up to 3 tools, and reads each result as JSON text. Then it returns one decision: use_value, keep or human_review, with a source and a reason. Apply Decisions accepts a value only when it is in the evidence; if not, the record goes to human review. This is the loop that Part 1 does not have." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;spacingLeft=12;spacingRight=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="900" height="100" as="geometry"/></mxCell><mxCell id="lg3" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="980" y="800" width="210" height="150" as="geometry"/></mxCell><mxCell id="lg3-s0" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg3"><mxGeometry x="10" y="30" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg3-t0" value="LLM step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg3"><mxGeometry x="50" y="28" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg3-s1" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lg3"><mxGeometry x="10" y="54" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg3-t1" value="Loop control" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg3"><mxGeometry x="50" y="52" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg3-s2" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lg3"><mxGeometry x="10" y="78" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg3-t2" value="Tool (reads data)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg3"><mxGeometry x="50" y="76" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg3-s3" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg3"><mxGeometry x="10" y="102" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg3-t3" value="Code check" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg3"><mxGeometry x="50" y="100" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg3-s4" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lg3"><mxGeometry x="10" y="126" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg3-t4" value="Data file" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg3"><mxGeometry x="50" y="124" width="150" height="20" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram><diagram id="p4" name="4 · One attendee, email to output"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Event AI · One attendee from email to output (e05 + e06 → A04)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="x5" value="&lt;b&gt;e05 · extract&lt;/b&gt; (work email, 3 Nov)&lt;br&gt;full_name: Jonathon Reed&lt;br&gt;email: J.Reed@Quillmere.example&lt;br&gt;phone: 0113 496 0461&lt;br&gt;company: Quillmere Events Ltd&lt;br&gt;dietary: &lt;i&gt;absent&lt;/i&gt;&lt;br&gt;attending: yes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="140" as="geometry"/></mxCell><mxCell id="x6" value="&lt;b&gt;e06 · extract&lt;/b&gt; (personal email, 5 Nov)&lt;br&gt;full_name: Jonathan Reed&lt;br&gt;email: jon.reed@mailbox.example&lt;br&gt;phone: &lt;i&gt;absent&lt;/i&gt;&lt;br&gt;company: Quillmere Events&lt;br&gt;dietary: no nuts&lt;br&gt;attending: yes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="260" height="140" as="geometry"/></mxCell><mxCell id="g" value="&lt;b&gt;ground&lt;/b&gt;&lt;br&gt;each value is found in its own email → kept&lt;br&gt;&lt;br&gt;&lt;i&gt;A value that is not in the email is removed and gets the flag not_in_source:&amp;lt;field&amp;gt;.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="165" width="260" height="140" as="geometry"/></mxCell><mxCell id="n" value="&lt;b&gt;normalize&lt;/b&gt;&lt;br&gt;email → j.reed@quillmere.example &lt;i&gt;(corrected)&lt;/i&gt;&lt;br&gt;phone → +441134960461 &lt;i&gt;(corrected, E.164)&lt;/i&gt;&lt;br&gt;names and company suffixes in one form&lt;br&gt;&lt;i&gt;Each change is an audit entry.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="165" width="280" height="140" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;dedupe&lt;/b&gt;&lt;br&gt;emails differ → fuzzy match:&lt;br&gt;name 92 · company 100 (suffix ignored)&lt;br&gt;→ &lt;b&gt;merged as A04&lt;/b&gt;&lt;br&gt;name: 2 values → conflict&lt;br&gt;email: 2 values → conflict&lt;br&gt;dietary: no nuts (the later email)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1020" y="165" width="280" height="140" as="geometry"/></mxCell><mxCell id="vf" value="&lt;b&gt;verify&lt;/b&gt;&lt;br&gt;CRM C005 matches the work email&lt;br&gt;name conflict → the CRM confirms &quot;Jonathan Reed&quot;&lt;br&gt;email conflict → the CRM confirms the work email&lt;br&gt;invited: yes · format: valid&lt;br&gt;Companies House: not on the register (note)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="280" height="150" as="geometry"/></mxCell><mxCell id="rs" value="&lt;b&gt;Agent step&lt;/b&gt;&lt;br&gt;no open flags → the record skips the Loop&lt;br&gt;&lt;br&gt;&lt;i&gt;A conflict that the CRM settles is a rule, so code settles it. The Agent gets only what needs judgement.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="680" y="420" width="280" height="150" as="geometry"/></mxCell><mxCell id="o" value="&lt;b&gt;Output row A04&lt;/b&gt; (attendees.csv)&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;th&gt;field&lt;/th&gt;&lt;th&gt;value&lt;/th&gt;&lt;th&gt;status&lt;/th&gt;&lt;th&gt;source&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;full_name&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Jonathan Reed&lt;/td&gt;&lt;td&gt;verified&lt;/td&gt;&lt;td&gt;crm.csv#C005 · gmail:e06&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;email&lt;/b&gt;&lt;/td&gt;&lt;td&gt;j.reed@quillmere.example&lt;/td&gt;&lt;td&gt;verified&lt;/td&gt;&lt;td&gt;gmail:e05 · crm.csv#C005&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;phone&lt;/b&gt;&lt;/td&gt;&lt;td&gt;+441134960461&lt;/td&gt;&lt;td&gt;corrected&lt;/td&gt;&lt;td&gt;gmail:e05&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;company&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Quillmere Events Ltd&lt;/td&gt;&lt;td&gt;verified&lt;/td&gt;&lt;td&gt;gmail:e05 · crm.csv#C005&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;company_number&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;absent&lt;/td&gt;&lt;td&gt;note: not on the register&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;dietary_needs&lt;/b&gt;&lt;/td&gt;&lt;td&gt;no nuts&lt;/td&gt;&lt;td&gt;verified&lt;/td&gt;&lt;td&gt;gmail:e06&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;flags&lt;/b&gt;&lt;/td&gt;&lt;td&gt;none&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;audit: 2 changes, 1 merge, 2 rules&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="580" height="230" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="x5" target="g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="x6" target="g"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g" target="n"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n" target="d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d" target="vf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="vf" target="rs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="rs" target="o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="st" value="&lt;b&gt;Field status&lt;/b&gt;&lt;br&gt;verified: in the source and passed the checks&lt;br&gt;corrected: changed by a rule or a resolution (old value in the audit log)&lt;br&gt;absent: no source has a value (never invented)&lt;br&gt;conflict: sources disagree; human review" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;spacingRight=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="620" width="340" height="110" as="geometry"/></mxCell><mxCell id="lg" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="1080" y="620" width="210" height="102" as="geometry"/></mxCell><mxCell id="lg-s0" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg"><mxGeometry x="10" y="30" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t0" value="LLM step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="50" y="28" width="150" height="20" as="geometry"/></mxCell><mxCell id="lg-s1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="10" y="54" width="30" height="16" as="geometry"/></mxCell><mxCell id="lg-t1" value="Code step" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" v