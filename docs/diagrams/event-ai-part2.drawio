        <mxCell id="note2" value="At most 3 tool calls (Max Iterations 4)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
