<?xml version="1.0" encoding="UTF-8"?><mxfile host="drawio" version="26.0.0"><diagram id="p1" name="1 · Part 2 architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Event AI · Part 2 architecture (attendee-list agent in Langflow)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="src" value="Event inputs (one source per run)" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=13;container=1;pointerEvents=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="220" height="330" as="geometry"/></mxCell><mxCell id="cal" value="&lt;b&gt;Google Calendar&lt;/b&gt;&lt;br&gt;event · invitees · venue ID&lt;br&gt;&lt;i&gt;calendar.readonly&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="src"><mxGeometry x="20" y="40" width="180" height="70" as="geometry"/></mxCell><mxCell id="gm" value="&lt;b&gt;Gmail&lt;/b&gt;&lt;br&gt;RSVP emails&lt;br&gt;&lt;i&gt;gmail.readonly&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="src"><mxGeometry x="20" y="130" width="180" height="70" as="geometry"/></mxCell><mxCell id="seed" value="&lt;b&gt;Seed files&lt;/b&gt; (offline source)&lt;br&gt;seed/event.yaml&lt;br&gt;seed/rsvp_emails.yaml" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="src"><mxGeometry x="20" y="230" width="180" height="80" as="geometry"/></mxCell><mxCell id="ref" value="Reference data" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=13;container=1;pointerEvents=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="220" height="200" as="geometry"/></mxCell><mxCell id="ven" value="&lt;b&gt;venues.csv&lt;/b&gt;&lt;br&gt;seated capacity (Part 1 data)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ref"><mxGeometry x="20" y="40" width="180" height="60" as="geometry"/></mxCell><mxCell id="crm" value="&lt;b&gt;crm.csv&lt;/b&gt;&lt;br&gt;known contacts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="ref"><mxGeometry x="20" y="120" width="180" height="60" as="geometry"/></mxCell><mxCell id="run" value="Langflow 1.13 flow on the laptop · own venv · Playground or API" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=13;container=1;pointerEvents=0;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="420" height="700" as="geometry"/></mxCell><mxCell id="fetch" value="&lt;b&gt;Load Event · Load RSVP Emails&lt;/b&gt; (code)&lt;br&gt;event, invitees, venue ID&lt;br&gt;emails with Date and Message-ID&lt;br&gt;10 s timeout · 3 retries" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="run"><mxGeometry x="40" y="50" width="340" height="170" as="geometry"/></mxCell><mxCell id="extract" value="&lt;b&gt;Extract RSVPs&lt;/b&gt; (LLM, one call per email)&lt;br&gt;free text → ExtractedRsvp · one retry, then the fallback model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="run"><mxGeometry x="40" y="260" width="340" height="60" as="geometry"/></mxCell><mxCell id="checks" value="&lt;b&gt;Check Records&lt;/b&gt; (code)&lt;br&gt;ground · normalize · dedupe · verify&lt;br&gt;CRM · invitees · capacity · Companies House" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="run"><mxGeometry x="40" y="360" width="340" height="90" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Loop → Agent → Agent Decision&lt;/b&gt; (flagged records only)&lt;br&gt;3 read-only tools · ≤ 3 calls for each flag&lt;br&gt;&lt;b&gt;Apply Decisions&lt;/b&gt; (code) checks each fix" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="run"><mxGeometry x="40" y="490" width="340" height="90" as="geometry"/></mxCell><mxCell id="write" value="&lt;b&gt;Planner Brief → Write Outputs&lt;/b&gt; (code)&lt;br&gt;Part 1 answers with sources · status and source for each field" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="run"><mxGeometry x="40" y="620" width="340" height="60" as="geometry"/></mxCell><mxCell id="ext" value="External services" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=13;container=1;pointerEvents=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="260" height="690" as="geometry"/></mxCell><mxCell id="lf" value="&lt;b&gt;Langfuse Cloud&lt;/b&gt;&lt;br&gt;one trace per run (Langflow server)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="ext"><mxGeometry x="20" y="40" width="220" height="70" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;LLM providers&lt;/b&gt; (free)&lt;br&gt;Groq gpt-oss-120b: extraction&lt;br&gt;OpenRouter Nemotron: agent step,&lt;br&gt;extraction fallback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="ext"><mxGeometry x="20" y="220" width="220" height="120" as="geometry"/></mxCell><mxCell id="ch" value="&lt;b&gt;Companies House API&lt;/b&gt;&lt;br&gt;company search · cached per run&lt;br&gt;fictional firms: &quot;not on the register&quot; note" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="ext"><mxGeometry x="20" y="400" width="220" height="100" as="geometry"/></mxCell><mxCell id="p1rag" value="&lt;b&gt;Part 1 RAG pipeline&lt;/b&gt;&lt;br&gt;ask() in the Part 1 venv (subprocess)&lt;br&gt;4 questions → cited answers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="ext"><mxGeometry x="20" y="580" width="220" height="90" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;outputs/&lt;/b&gt; (committed)&lt;br&gt;attendees.csv · audit_log.json&lt;br&gt;run_report.json · planner_brief.md" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="820" width="260" height="90" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;Streamlit app&lt;/b&gt; (Community Cloud)&lt;br&gt;Part 2 results page · read-only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="820" y="830" width="240" height="70" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;eval/run_part2.py&lt;/b&gt; (code)&lt;br&gt;flag precision and recall&lt;br&gt;vs seed/expected_attendees.csv" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="825" width="260" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.206;" edge="1" parent="1" source="cal" target="fetch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.735;" edge="1" parent="1" source="gm" target="fetch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="Source = seed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#7f7f7f;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="seed" target="fetch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="340"/><mxPoint x="300" y="273"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fetch" target="extract"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="extract" target="checks"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="review queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="checks" target="agent"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="agent" tar